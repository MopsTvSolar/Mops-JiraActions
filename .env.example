# URL do seu Jira Cloud (sem barra no final)
# Exemplo: https://suaempresa.atlassian.net
JIRA_URL=https://clarobr.atlassian.net

# E-mail da conta usada para gerar o API Token (usado por todo o time no jira_gui.py)
JIRA_EMAIL=seu.email@claro.com.br

# API Token gerado em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=coloque_seu_token_aqui

# Projeto do Jira usado como filtro fixo nas ações "A violar", "Violados" e
# "Extração completa" da versão web, e no report diário. Opcional — se não
# definido, usa "Central de Incidentes".
JIRA_PROJETO=Central de Incidentes

# JQL padrão usado quando --jql não é informado na linha de comando (CLI)
# e é a consulta fixa usada pela interface gráfica (jira_gui.py) e pela
# caixa "Mops Solar" na versão web (api/index.py)
JIRA_JQL='"Grupo Solucionador[Group Picker (single group)]" IN ("CLBR-TI-OPS-OGS-SOLAR-SALESFORCE-N2","CLBR-TI-OPS-OGS SOLAR SALESFORCE", "CLBR-TI-OPS-PROD SOLAR SALESFORCE" ) AND project = "Central de Incidentes" AND status NOT IN ("Resolvido", "Encerrado", "Cancelado", "Reprovado", "Arquivado") ORDER BY cf[10419] ASC'

# JQL fixa da caixa "Mops Tv do Futuro" na versão web (api/index.py) — só é
# lida quando essa caixa é selecionada na tela; se não configurar, o botão
# "Mops Tv do Futuro" mostra um erro claro em vez de usar dado errado.
# Ajuste o projeto/status se forem diferentes dos usados pelo Mops Solar.
JIRA_JQL_TV='"Grupo Solucionador[Group Picker (single group)]" IN ("CLBR-TI-OPS-MOPS TV DO FUTURO","CLBR-TI-OPS-MOPS-TV DO FUTURO N2") AND project = "Central de Incidentes" AND status NOT IN ("Resolvido", "Encerrado", "Cancelado", "Reprovado", "Arquivado") ORDER BY cf[10419] ASC'

# Quantidade de chamados buscados por página (máximo permitido pela API: 100)
JIRA_PAGE_SIZE=100
