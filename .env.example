# URL do seu Jira Cloud (sem barra no final)
# Exemplo: https://suaempresa.atlassian.net
JIRA_URL=https://clarobr.atlassian.net

# E-mail da conta usada para gerar o API Token (usado por todo o time no jira_gui.py)
JIRA_EMAIL=seu.email@claro.com.br

# API Token gerado em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=coloque_seu_token_aqui

# JQL padrão usado quando --jql não é informado na linha de comando (CLI)
# e é a consulta fixa usada pela interface gráfica (jira_gui.py)
JIRA_JQL='"Grupo Solucionador[Group Picker (single group)]" IN ("CLBR-TI-OPS-OGS-SOLAR-SALESFORCE-N2","CLBR-TI-OPS-OGS SOLAR SALESFORCE", "CLBR-TI-OPS-PROD SOLAR SALESFORCE" ) AND project = "Central de Incidentes" AND status NOT IN ("Resolvido", "Encerrado", "Cancelado", "Reprovado", "Arquivado") ORDER BY cf[10419] ASC'

# Quantidade de chamados buscados por página (máximo permitido pela API: 100)
JIRA_PAGE_SIZE=100
